<!-- Advanced features: categories and rows are shown in this order. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/app_name">

    <PreferenceCategory
        android:key="lenovo_features"
        android:title="@string/lenovo_features_category">

        <Preference
            android:key="landscape_view"
            android:title="@string/landscape_title"
            android:fragment="org.lineageos.settings.device.LandscapeViewFragment" />

        <SwitchPreferenceCompat
            android:key="folio_case_mode"
            android:title="@string/lkb_folio_case_mode"
            android:summary="@string/lkb_folio_case_mode_summary"
            android:persistent="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="performance"
        android:title="@string/performance_category">

        <!-- Opens the separate game performance app; hidden while it is not installed -->
        <Preference
            android:key="game_perf"
            android:title="@string/game_perf_title"
            android:summary="@string/game_perf_summary" />

        <ListPreference
            android:key="vram_gb"
            android:title="@string/vram_title"
            android:dialogTitle="@string/vram_title"
            android:persistent="false" />

        <Preference
            android:key="memory_status"
            android:title="@string/memory_status_title"
            android:selectable="false" />

    </PreferenceCategory>

    <!-- Opens Device Spoofing (ExperimentalFeatures) and Specter (PlayIntegrityFixSettings);
         rows and category are hidden while those optional apps are not installed -->
    <PreferenceCategory
        android:key="experimental_features"
        android:title="@string/experimental_features_category">

        <Preference
            android:key="device_spoof"
            android:title="@string/device_spoof_title" />

        <Preference
            android:key="specter"
            android:title="@string/specter_title" />

    </PreferenceCategory>
</PreferenceScreen>
