<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/bypass_title">

    <com.android.settingslib.widget.TopIntroPreference
        android:key="bypass_intro"
        android:title="@string/bypass_intro" />

    <com.android.settingslib.widget.MainSwitchPreference
        android:key="bypass_main"
        android:title="@string/bypass_main_title"
        android:persistent="false" />

    <PreferenceCategory
        android:key="bypass_mode"
        android:title="@string/bypass_mode_category">

        <com.android.settingslib.widget.SelectorWithWidgetPreference
            android:key="bypass_always"
            android:title="@string/bypass_always_title"
            android:summary="@string/bypass_always_summary"
            android:persistent="false" />

        <com.android.settingslib.widget.SelectorWithWidgetPreference
            android:key="bypass_once"
            android:title="@string/bypass_once_title"
            android:summary="@string/bypass_once_summary"
            android:persistent="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="bypass_range_category"
        android:title="@string/bypass_range_category">

        <com.tb520fu.parts.RangeSliderPreference
            android:key="bypass_range"
            android:title="@string/bypass_range_title"
            android:persistent="false" />

    </PreferenceCategory>

    <com.android.settingslib.widget.FooterPreference
        android:key="bypass_footer"
        android:title="@string/bypass_footer"
        android:selectable="false" />
</PreferenceScreen>
