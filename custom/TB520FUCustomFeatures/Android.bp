//
// "Custom Tweaks" (Settings > System): the optional TB520FU customizations
// with a UI - game performance and the Play Store installer switch. The device
// tree's
// TB520FUParts stays the device port; this app exists only while
// hardware/lenovo/custom is included.
//

android_app {
    name: "TB520FUCustomFeatures",

    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    static_libs: [
        "SettingsLib",
        "androidx.preference_preference",
    ],

    required: ["privapp-permissions-customfeatures.xml"],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
}

prebuilt_etc {
    name: "privapp-permissions-customfeatures.xml",
    src: "privapp-permissions-customfeatures.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
