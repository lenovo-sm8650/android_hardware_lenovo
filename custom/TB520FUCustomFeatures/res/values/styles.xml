<resources>
    <!-- Nothing keeps this process alive (unlike TB520FUParts and its Quick
         Settings tile), so the first open after boot is a cold start: the
         starting window made Settings show it with the app launch animation
         (from the bottom) instead of the sub page slide. Without the starting
         window the activity opens like any other Settings page. -->
    <style name="Theme.CustomTweaks" parent="@style/Theme.SubSettingsBase.Expressive">
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
