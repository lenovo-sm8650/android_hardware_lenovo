//
// Framework resources of the Experimental features app: the default device
// identity for selected apps. Installed with ExperimentalFeatures (custom.mk), so a
// build without the app does not carry them.
//

runtime_resource_overlay {
    name: "FrameworksResExperimental",
    product_specific: true,
}
