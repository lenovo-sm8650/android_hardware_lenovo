<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.settings.experimental"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.REBOOT" />

    <queries>
        <package android:name="io.github.wnduddld0513.pif" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.ExperimentalFeatures">

        <!-- No Settings homepage or System tile of its own: Advanced features
             (LenovoParts) starts it with an explicit intent. Callers must hold
             WRITE_SECURE_SETTINGS (the system uid, Settings), so apps cannot open it. -->
        <activity
            android:name=".ExperimentalFeaturesActivity"
            android:label="@string/app_name"
            android:permission="android.permission.WRITE_SECURE_SETTINGS"
            android:exported="true" />

    </application>
</manifest>
