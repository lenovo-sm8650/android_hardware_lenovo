<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/app_name">

    <PreferenceCategory
        android:key="spoofing"
        android:title="@string/spoofing_category">

        <Preference
            android:key="device_spoof"
            android:title="@string/device_spoof_title"
            android:fragment="org.lineageos.settings.experimental.DeviceSpoofFragment" />

    </PreferenceCategory>

    <!-- Specter opens the page of the separate Play Integrity Fix app and is hidden while
         that app is not installed; the other two open the PixelOS spoofing pages of
         Developer options -->
    <PreferenceCategory
        android:key="integrity"
        android:title="@string/integrity_category">

        <Preference
            android:key="specter"
            android:title="@string/specter_title" />

        <Preference
            android:key="play_integrity"
            android:title="@string/play_integrity_fix_title" />

        <Preference
            android:key="trickystore"
            android:title="@string/trickystore_title" />

    </PreferenceCategory>

</PreferenceScreen>
