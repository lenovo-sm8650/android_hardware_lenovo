<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/app_name">

    <PreferenceCategory
        android:key="app_compat"
        android:title="@string/app_compat_category">

        <Preference
            android:key="device_spoof"
            android:title="@string/device_spoof_title"
            android:fragment="org.lineageos.settings.experimental.DeviceSpoofFragment" />

        <Preference
            android:key="installer_spoof"
            android:title="@string/installer_spoof_title"
            android:fragment="org.lineageos.settings.experimental.InstallerSpoofFragment" />

    </PreferenceCategory>

    <!-- Opens the separate Play Integrity Fix app; made visible in code only when it is installed -->
    <Preference
        android:key="play_integrity"
        android:title="@string/play_integrity_fix_title"
        app:isPreferenceVisible="false" />

</PreferenceScreen>
