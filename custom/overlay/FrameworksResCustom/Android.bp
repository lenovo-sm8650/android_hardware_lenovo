//
// Framework resources of the optional TB520FU customizations: the default
// wallpaper. A separate overlay from FrameworksResTarget so a plain build (no
// customizations repository) never sees it. The device identity defaults belong
// to the Experimental features app (ExperimentalFeatures/overlay).
//

runtime_resource_overlay {
    name: "FrameworksResCustom",
    product_specific: true,
}
