//
// Game performance enforcement, loaded into system_server by lenovo-input.
// InputCore loads /system_ext/framework/lenovo-input-custom.jar when it is
// present and calls com.zui.server.input.custom.CustomInput through
// com.zui.server.input.InputExtension, so a plain build without this repository
// simply has no game performance enforcement.
//

java_library {
    name: "lenovo-input-custom",

    srcs: ["src/**/*.java"],
    libs: ["lenovo-input"],
    platform_apis: true,
    system_ext_specific: true,
    installable: true,
}
